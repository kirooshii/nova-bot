# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here
# Bot username without @, used for deep links (t.me/<username>/...)
# Prod: rosecap_nova_bot | Test: your test bot username
BOT_USERNAME=rosecap_nova_bot
# SQLite file — prod uses nova.db, local test uses e.g. nova.test.db
DB_PATH=nova.db
# FastAPI port — prod 8000, local test e.g. 8001
PORT=8000
# Cached group photos dir — test can use photos_test/
PHOTOS_DIR=photos
